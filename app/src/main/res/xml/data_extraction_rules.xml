<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以降：バックアップと機種変更の引き継ぎに含めるもの（設定だけ） -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="calendar_prefs.xml" />
        <include domain="sharedpref" path="month_widget.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="calendar_prefs.xml" />
        <include domain="sharedpref" path="month_widget.xml" />
    </device-transfer>
</data-extraction-rules>
